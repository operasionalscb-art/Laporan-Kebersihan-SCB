{
  "entities": {
    "Report": {
      "title": "Report",
      "description": "Daily cleaning service inspection report submitted by officers at SCB",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the report document",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tanggal": {
          "type": "string",
          "description": "Report date in YYYY-MM-DD format",
          "minLength": 8,
          "maxLength": 20
        },
        "waktu": {
          "type": "string",
          "description": "Report time in HH:mm format",
          "minLength": 4,
          "maxLength": 20
        },
        "timestamp": {
          "type": "number",
          "description": "Unix epoch timestamp in milliseconds"
        },
        "petugasId": {
          "type": "string",
          "description": "Identifier of the officer who submitted the report",
          "minLength": 1,
          "maxLength": 128
        },
        "namaPetugas": {
          "type": "string",
          "description": "Display name of the officer",
          "minLength": 1,
          "maxLength": 120
        },
        "area": {
          "type": "string",
          "description": "Cleaned room or facility area name",
          "minLength": 1,
          "maxLength": 150
        },
        "isAreaOther": {
          "type": "boolean",
          "description": "Whether a custom area name was entered"
        },
        "areaCustom": {
          "type": "string",
          "description": "Custom area name when isAreaOther is true",
          "maxLength": 150
        },
        "checklist": {
          "type": "array",
          "description": "List of completed sanitation checklist labels"
        },
        "checklistCustom": {
          "type": "string",
          "description": "Optional custom checklist note",
          "maxLength": 500
        },
        "kondisiAkhir": {
          "type": "string",
          "enum": ["Bersih", "Perlu Pengecekan Ulang", "Ada Kerusakan"],
          "description": "Final condition assessment of the area"
        },
        "keteranganTambahan": {
          "type": "string",
          "description": "Additional inspection notes or issue details",
          "maxLength": 2000
        },
        "fotoBukti": {
          "type": "array",
          "description": "Array of compressed image data URLs, micro-thumbnail, or Google Drive links (max 10 items)"
        },
        "fotoCount": {
          "type": "integer",
          "description": "Total number of attached photos when full photos are offloaded"
        },
        "photosOffloaded": {
          "type": "boolean",
          "description": "Whether full-resolution photos are stored in /report_photos/{reportId}"
        },
        "drivePhotoLinks": {
          "type": "array",
          "description": "Optional archived Google Drive photo links (max 10 items)"
        },
        "statusVerifikasi": {
          "type": "string",
          "enum": ["Menunggu", "Disetujui", "Perlu Perbaikan"],
          "description": "Supervisor verification workflow status"
        },
        "catatanSupervisor": {
          "type": "string",
          "description": "Supervisor feedback or corrective instruction",
          "maxLength": 2000
        },
        "diverifikasiOleh": {
          "type": "string",
          "description": "Name and role of the verifying supervisor",
          "maxLength": 150
        },
        "diverifikasiPada": {
          "type": "string",
          "description": "Human-readable verification timestamp",
          "maxLength": 80
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the authenticated creator",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp"
        }
      },
      "required": [
        "id",
        "tanggal",
        "waktu",
        "timestamp",
        "petugasId",
        "namaPetugas",
        "area",
        "isAreaOther",
        "checklist",
        "kondisiAkhir",
        "keteranganTambahan",
        "fotoBukti",
        "statusVerifikasi"
      ]
    },
    "User": {
      "title": "User",
      "description": "Registered staff, supervisor, and superadmin account profiles containing PII",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "password": {
          "type": "string",
          "maxLength": 128
        },
        "pin": {
          "type": "string",
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "supervisor", "petugas"]
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40
        },
        "avatarColor": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": ["id", "name", "email", "username", "role", "isActive", "createdAt"]
    },
    "FormConfig": {
      "title": "FormConfig",
      "description": "Master rooms, sanitation checklist items, and form behavior settings",
      "type": "object",
      "properties": {
        "rooms": {
          "type": "array",
          "description": "Configured facility areas for cleaning reports"
        },
        "checklists": {
          "type": "array",
          "description": "Standard sanitation checklist definitions"
        },
        "settings": {
          "type": "object",
          "description": "Global form validation and SOP settings"
        }
      },
      "required": ["rooms", "checklists", "settings"]
    },
    "RoomScheduleDoc": {
      "title": "RoomScheduleDoc",
      "description": "Active officer-to-room assignment schedule configuration",
      "type": "object",
      "properties": {
        "schedules": {
          "type": "array",
          "description": "List of room assignments per officer and active weekdays"
        }
      },
      "required": ["schedules"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted superadmin authorization records keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["superadmin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "StaffRole": {
      "title": "StaffRole",
      "description": "Authoritative active staff role lookup keyed by sanitized lowercase email",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "supervisor", "petugas"]
        },
        "isActive": {
          "type": "boolean"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "isActive"]
    },
    "ReportPhoto": {
      "title": "ReportPhoto",
      "description": "On-demand full-resolution compressed photo evidence for a cleaning report",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "photos": {
          "type": "array",
          "description": "Full list of compressed evidence image data URLs (max 10 items)"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "photos"]
    },
    "PublicSummary": {
      "title": "PublicSummary",
      "description": "Single lightweight non-PII daily reporting notification summary document for non-logged-in visitors",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^daily_notifications$"
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "totalScheduledToday": {
          "type": "integer"
        },
        "reportedAreaCount": {
          "type": "integer"
        },
        "pendingAreas": {
          "type": "array",
          "description": "List of scheduled area names not yet reported today (max 100)"
        },
        "notifications": {
          "type": "array",
          "description": "Compact list of recent daily reporting notifications without photos (max 20)"
        },
        "updatedAtMs": {
          "type": "number"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "date",
        "totalScheduledToday",
        "reportedAreaCount",
        "pendingAreas",
        "notifications",
        "updatedAtMs"
      ]
    },
    "AccountActivity": {
      "title": "AccountActivity",
      "description": "Per-user last login and device telemetry recorded only on login or day/device change",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "supervisor", "petugas"]
        },
        "deviceType": {
          "type": "string",
          "enum": ["Desktop", "Mobile", "Tablet"]
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "browser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "deviceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "screenInfo": {
          "type": "string",
          "maxLength": 40
        },
        "lastActiveDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "lastActiveAtMs": {
          "type": "number"
        },
        "recentLogins": {
          "type": "array",
          "description": "Up to 5 recent formatted login timestamps and device labels"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userId",
        "email",
        "name",
        "role",
        "deviceType",
        "os",
        "browser",
        "deviceLabel",
        "lastActiveDate",
        "lastActiveAtMs",
        "updatedAt"
      ]
    },
    "SupervisorInspection": {
      "title": "SupervisorInspection",
      "description": "Daily supervisor physical cross-check patrol stored as one consolidated document per date",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "supervisorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supervisorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supervisorEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "items": {
          "type": "array",
          "description": "List of inspected room check entries for this date (max 100)"
        },
        "summaryScore": {
          "type": "number"
        },
        "totalChecked": {
          "type": "integer"
        },
        "matchCount": {
          "type": "integer"
        },
        "issueCount": {
          "type": "integer"
        },
        "updatedAtMs": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "date",
        "supervisorUid",
        "supervisorName",
        "supervisorEmail",
        "items",
        "summaryScore",
        "totalChecked",
        "matchCount",
        "issueCount",
        "updatedAtMs",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of all cleaning service inspection reports"
    },
    "/report_photos/{reportId}": {
      "schema": "ReportPhoto",
      "description": "On-demand full-resolution evidence photos separated from report summaries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered officers, supervisors, and administrators (PII protected)"
    },
    "/form_configs/{configId}": {
      "schema": "FormConfig",
      "description": "Master form configurations (rooms, checklists, settings)"
    },
    "/room_schedules/{scheduleId}": {
      "schema": "RoomScheduleDoc",
      "description": "Officer room assignment schedules"
    },
    "/staff_roles/{emailId}": {
      "schema": "StaffRole",
      "description": "Trusted active staff role mapping keyed by sanitized email"
    },
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Authoritative admin UID registry for privileged operations"
    },
    "/public_summary/{summaryId}": {
      "schema": "PublicSummary",
      "description": "Single-document daily cleaning notification summary for non-logged-in landing page"
    },
    "/account_activity/{uid}": {
      "schema": "AccountActivity",
      "description": "Per-account login timestamp and device metadata readable by Superadmin"
    },
    "/supervisor_inspections/{dateId}": {
      "schema": "SupervisorInspection",
      "description": "Single-document-per-day supervisor cross-check patrol log"
    }
  }
}
